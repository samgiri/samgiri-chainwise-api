# Database
DATABASE_URL=postgresql://user:password@host:5432/chainwise

# API Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=https://thechainwise.com
CORS_ORIGIN=https://thechainwise.com

# Blockchain APIs (for Phase 2)
ETHERSCAN_API_KEY=your_etherscan_key

# Email (for Phase 1)
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@thechainwise.com

# Telegram bot (for Phase 4)
TELEGRAM_BOT_TOKEN=your_botfather_token
WEBHOOK_SECRET=random_string_for_telegram_secret_token_header
API_BASE_URL=https://chainwise-api-production.vercel.app
